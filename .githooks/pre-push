#!/bin/sh
# Soft guard: block direct pushes to protected branches.
# GitHub Free can't enforce this on a private repo, so this local hook stands in.
# Owner override: run with ALLOW_DIRECT_PUSH=1 (e.g. pushing to staging).
protected="refs/heads/main refs/heads/staging"

while read -r local_ref local_sha remote_ref remote_sha; do
  for branch in $protected; do
    if [ "$remote_ref" = "$branch" ]; then
      if [ "$ALLOW_DIRECT_PUSH" = "1" ]; then
        echo "pre-push: ALLOW_DIRECT_PUSH=1 set — permitting push to ${branch#refs/heads/}." >&2
      else
        echo "pre-push: direct pushes to '${branch#refs/heads/}' are blocked. Open a PR instead." >&2
        echo "          (owner override: ALLOW_DIRECT_PUSH=1 git push ...)" >&2
        exit 1
      fi
    fi
  done
done

exit 0
